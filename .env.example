# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Calendar (Read-Only — for surgery schedule display in booking modal)
# Both versions needed: NEXT_PUBLIC_* for client-side, plain for server-side
NEXT_PUBLIC_GOOGLE_CALENDAR_ID=your_google_calendar_id
NEXT_PUBLIC_GOOGLE_API_KEY=your_google_api_key
GOOGLE_CALENDAR_ID=your_google_calendar_id
GOOGLE_API_KEY=your_google_api_key

# Google Calendar (Write — to push confirmed appointments to Google Calendar)
# Get from Google Cloud Console → Service Accounts → Create Key → JSON
GOOGLE_CLIENT_EMAIL=your_service_account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour\nMulti\nLine\nPrivate\nKey\nHere\n-----END PRIVATE KEY-----\n"

# Semaphore SMS (for booking confirmation SMS to patients)
SEMAPHORE_API_KEY=your_semaphore_api_key
SEMAPHORE_SENDER_NAME=PreciousMD

# Resend Email (for booking confirmation emails — requires verified domain)
RESEND_API_KEY=re_your_resend_api_key
